# CAR, CRVAL2 = 30, LONPOLE = 60.0000000066: celset's slz = sin(lat0) /
# |cos(phip - phi0)| = 1 + 2e-10 is outside its 1e-10 tolerance, so wcslib
# refuses the header. Twin of hdrcases/celpole_slz_within_tol. Synthetic.
# EXPECT-WCSLIB-ERROR: is required for these values of phip, phi0, and theta0
NOTE reject: celpole_slz_tol_out
GRID 1 512 3 1 512 3
HEADER
NAXIS   = 2
NAXIS1  = 512
NAXIS2  = 512
CTYPE1  = 'RA---CAR'
CTYPE2  = 'DEC--CAR'
CRVAL1  = 10.0
CRVAL2  = 30.0
CRPIX1  = 256.5
CRPIX2  = 256.5
CDELT1  = -0.1
CDELT2  = 0.1
LONPOLE = 60.0000000066
