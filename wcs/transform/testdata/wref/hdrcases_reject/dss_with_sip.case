# DSS plate keywords together with SIP keywords (synthetic). wcslib 8.10
# keeps one translated distortion type (distran in wcspih.l, whichever kind
# its lexer met last) but stores the other kind's keyvalues too, and
# disset then refuses the header ("No distortion type, yet DPja keyvalues
# are present"; with the SIP cards last it is DQia). Refused here too.
# AP/BP are given so hdr2sky injects nothing.
# EXPECT-WCSLIB-ERROR: No distortion type, yet DPja keyvalues are present
NOTE reject: dss_with_sip
GRID 1 400 3 1 300 3
HEADER
CTYPE1  = 'RA---TAN-SIP'
CTYPE2  = 'DEC--TAN-SIP'
CRPIX1  = 200.5
CRPIX2  = 150.5
CRVAL1  = 83.633
CRVAL2  = 22.0145
CD1_1   = -0.000472
CD2_2   = 0.000472
A_ORDER = 2
A_2_0   = 1.0E-6
B_ORDER = 2
B_0_2   = 1.0E-6
AP_ORDER= 1
AP_0_0  = 0.0
BP_ORDER= 1
BP_0_0  = 0.0
NAXIS   = 2
NAXIS1  = 400
NAXIS2  = 300
CNPIX1  = 9120
CNPIX2  = 4410
XPIXELSZ= 25.28445
YPIXELSZ= 25.28445
PPO3    = 177500.0
PPO6    = 177500.0
PLTRAH  = 5
PLTRAM  = 34
PLTRAS  = 31.94
PLTDECSN= '+'
PLTDECD = 22
PLTDECM = 0
PLTDECS = 52.2
AMDX1   = 6.7165566279E+01
AMDX2   = 1.8513587312E-02
AMDX3   = -4.3815032712E+01
AMDX4   = -1.2310232101E-05
