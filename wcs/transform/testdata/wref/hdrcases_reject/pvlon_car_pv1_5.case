# PV1_5 on the longitude axis of a non-TPV projection (synthetic). Only
# PVi_0..4 are defined there (Paper II sect. 2.5); wcslib refuses the
# keyword instead of ignoring it.
# EXPECT-WCSLIB-ERROR: Unrecognized coordinate transformation parameter
NOTE reject: pvlon_car_pv1_5
GRID 1 360 5 1 180 5
HEADER
NAXIS   = 2
NAXIS1  = 360
NAXIS2  = 180
CTYPE1  = 'RA---CAR'
CTYPE2  = 'DEC--CAR'
CRVAL1  = 40.0
CRVAL2  = 0.0
CRPIX1  = 180.5
CRPIX2  = 90.5
CDELT1  = -0.5
CDELT2  = 0.5
PV1_5   = 3.0
