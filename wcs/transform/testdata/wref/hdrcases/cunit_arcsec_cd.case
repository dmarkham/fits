NAXIS1  = 512
NAXIS2  = 512
CTYPE1  = 'RA---TAN'
CTYPE2  = 'DEC--TAN'
CUNIT1  = 'arcsec'
CUNIT2  = 'arcsec'
CRVAL1  = 720000.0
CRVAL2  = 144000.0
CRPIX1  = 256.5
CRPIX2  = 256.5
CD1_1   = -0.8
CD1_2   = 0.3
CD2_1   = 0.25
CD2_2   = 0.75
