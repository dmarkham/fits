# SIP on a 3-axis cube: RA---TAN-SIP, DEC--TAN-SIP on pixel axes 1,2 and a
# FREQ axis 3 (synthetic). SIP applies to pixel axes 1,2 only; the spectral
# axis is linear and does not enter the celestial answer. Asymmetric A/B,
# rotated CD, PC-free; AP/BP absent (hdr2sky injects an identity start).
NOTE SIP on a RA,DEC,FREQ cube
GRID 1 2048 9 1 1024 9
PIX 1 1
PIX 2048 1024
HEADER
NAXIS   = 3
NAXIS1  = 2048
NAXIS2  = 1024
NAXIS3  = 16
CTYPE1  = 'RA---TAN-SIP'
CTYPE2  = 'DEC--TAN-SIP'
CTYPE3  = 'FREQ'
CUNIT3  = 'Hz'
CRVAL1  = 210.5
CRVAL2  = -35.25
CRVAL3  = 1.4e9
CRPIX1  = 1024.5
CRPIX2  = 400.5
CRPIX3  = 8.0
CD1_1   = -0.00018
CD1_2   = 0.00004
CD2_1   = 0.00003
CD2_2   = 0.00021
CD3_3   = 1.0e6
A_ORDER = 3
B_ORDER = 3
A_2_0   = 2.5e-6
A_1_1   = -1.2e-6
A_0_2   = 4.0e-7
A_3_0   = 3.0e-10
A_0_3   = -2.0e-10
B_2_0   = -6.0e-7
B_1_1   = 1.5e-6
B_0_2   = 3.0e-6
B_1_2   = 4.0e-10
B_2_1   = -1.0e-10
