# CUNIT = rad on both celestial axes, CRVAL and CDELT in radians
# (synthetic).
NOTE pipeline: CUNIT rad
GRID 1 512 9 1 512 9
PIX 256.5 256.5
HEADER
NAXIS   = 2
NAXIS1  = 512
NAXIS2  = 512
CTYPE1  = 'RA---ZEA'
CTYPE2  = 'DEC--ZEA'
CUNIT1  = 'rad'
CUNIT2  = 'rad'
CRVAL1  = 1.0
CRVAL2  = 0.5
CRPIX1  = 256.5
CRPIX2  = 256.5
CDELT1  = -1.0E-4
CDELT2  = 1.0E-4
