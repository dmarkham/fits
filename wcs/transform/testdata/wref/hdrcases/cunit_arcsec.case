# CUNIT = arcsec on both celestial axes: CRVAL and CDELT are in arcsec
# (synthetic, audit probe h/cunit_arcsec.hdr). wcslib converts them to
# degrees (CRVAL1 = 0.05 deg here).
NOTE pipeline: CUNIT arcsec with PC + CDELT
GRID 1 512 9 1 512 9
PIX 256.5 256.5
HEADER
NAXIS   = 2
NAXIS1  = 512
NAXIS2  = 512
CTYPE1  = 'RA---TAN'
CTYPE2  = 'DEC--TAN'
CUNIT1  = 'arcsec'
CUNIT2  = 'arcsec'
CRVAL1  = 180.0
CRVAL2  = 30.0
CRPIX1  = 256.5
CRPIX2  = 256.5
CDELT1  = -1.0
CDELT2  = 1.0
