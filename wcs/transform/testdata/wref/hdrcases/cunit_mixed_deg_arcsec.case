# Mixed celestial units: CUNIT1 = 'deg', CUNIT2 = 'arcsec' (CDELT2 given in
# arcsec). Each axis is converted with its OWN unit (wcslib wcs_units);
# every other cunit_* case uses the same unit on both axes. Synthetic.
NOTE pipeline: per-axis CUNIT, deg longitude with arcsec latitude
GRID 1 512 9 1 512 9
HEADER
NAXIS   = 2
NAXIS1  = 512
NAXIS2  = 512
CTYPE1  = 'RA---TAN'
CTYPE2  = 'DEC--TAN'
CUNIT1  = 'deg'
CUNIT2  = 'arcsec'
CRVAL1  = 180.0
CRVAL2  = 108000.0
CRPIX1  = 256.5
CRPIX2  = 256.5
CDELT1  = -0.001
CDELT2  = 3.6
