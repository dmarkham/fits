NAXIS1  = 512
NAXIS2  = 512
CTYPE1  = 'RA---CEA'
CTYPE2  = 'DEC--CEA'
CRVAL1  = 200.0
CRVAL2  = 0.0
CRPIX1  = 256.5
CRPIX2  = 256.5
CDELT1  = -0.1
CDELT2  = 0.1
LONPOLE = 90.0
LATPOLE = 40.0
