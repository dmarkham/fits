# CAR at CRVAL2 = 30 with an explicit LONPOLE = 0 (synthetic, from the
# WCS audit probe h/car_dec30_lonpole0.hdr). transform.go used to assume
# phi_p = 180 for every non-zenithal projection; with LONPOLE = 0 the
# celestial pole is on the other side and every point came out wrong.
# Grid stays inside the CAR map (|x| < 180, |y| < 90 deg).
NOTE pipeline: LONPOLE = 0 on a cylindrical projection, CRVAL2 = 30
GRID 1 512 9 1 512 9
PIX 256.5 256.5
SKYGRID 90 110 5 15 45 5
HEADER
NAXIS   = 2
NAXIS1  = 512
NAXIS2  = 512
CTYPE1  = 'RA---CAR'
CTYPE2  = 'DEC--CAR'
CRVAL1  = 100.0
CRVAL2  = 30.0
CRPIX1  = 256.5
CRPIX2  = 256.5
CDELT1  = -0.1
CDELT2  = 0.1
LONPOLE = 0.0
