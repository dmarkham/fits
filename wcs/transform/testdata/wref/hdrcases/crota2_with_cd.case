# CD matrix AND CROTA2 = 25 (synthetic, crota2_tan plus a rotated CD).
# Real headers often carry CROTA2 next to CD; CD takes precedence and
# CROTA2 is ignored (wcslib altlin). Letting CROTA2 win gives 681 arcsec
# at grid corner (-100, -100).
NOTE pipeline: CD wins over CROTA2
GRID -100 612 9 -100 612 9
PIX 256.5 256.5
HEADER
NAXIS   = 2
NAXIS1  = 512
NAXIS2  = 512
CTYPE1  = 'RA---TAN'
CTYPE2  = 'DEC--TAN'
CRVAL1  = 180.0
CRVAL2  = 30.0
CRPIX1  = 256.5
CRPIX2  = 256.5
CDELT1  = -0.001
CDELT2  = 0.001
CD1_1   = -0.0012
CD2_2   = 0.0009
CD1_2   = 0.0002
CROTA2  = 25.0
