# SIP keywords (A_ORDER/B_ORDER, A_p_q/B_p_q) on a plain 'RA---TAN' header
# with NO '-SIP' suffix (synthetic). wcslib 8.10 wcspih sets the SIP prior
# distortion from the A_p_q/B_p_q keywords alone, whatever CTYPE says
# (wcspih.l: distran = SIP on <SIP2>/<SIP3>; wcspih_init1 attaches it to the
# primary), so the polynomial is applied: ~8 arcsec / 8 px at the corners.
# No AP/BP: hdr2sky injects an identity inverse start for wcslib only.
NOTE pipeline: SIP keywords without the -SIP suffix are applied (TAN)
GRID 1 1024 9 1 1024 9
PIX 1 1
HEADER
NAXIS   = 2
NAXIS1  = 1024
NAXIS2  = 1024
CRVAL1  = 150.0
CRVAL2  = 2.0
CRPIX1  = 512.5
CRPIX2  = 512.5
CTYPE1  = 'RA---TAN'
CTYPE2  = 'DEC--TAN'
CD1_1   = -0.0002777
CD1_2   = 0.0
CD2_1   = 0.0
CD2_2   = 0.0002777
A_ORDER = 2
B_ORDER = 2
A_2_0   = 2e-5
A_1_1   = 1e-5
B_0_2   = 2e-5
B_1_1   = -1e-5
