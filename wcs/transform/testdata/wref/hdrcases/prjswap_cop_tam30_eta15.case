# Generated by gen_prj_cases.py: synthetic COP header for the
# latitude-first axis order proof (see that script for the design).
NOTE projection COP: COP southern, latitude first; latitude CRVAL1 = -20
GRID 1.13 498.71 15 1.29 498.53 15
SKYGRID 0.71 359.13 13 -89.37 89.21 13
# Sky points near the COP divergence map to |pixel| ~ 4e4, so the
# default 1e-9 px absolute budget is below the float64 relative
# precision there; 5e-8 px is 1.2e-12 relative at 4e4 px.
TOL_PX 5e-8
HEADER
NAXIS   = 2
NAXIS1  = 500
NAXIS2  = 500
CTYPE1  = 'DEC--COP'
CTYPE2  = 'RA---COP'
CRVAL1  = -20.0
CRVAL2  = 37.3
CRPIX1  = 250.37
CRPIX2  = 250.61
CDELT1  = 1.0
CDELT2  = -1.0
PV1_1   = -30.0
PV1_2   = 15.0
