# Defunct CD00i00j matrix keywords (synthetic), no CDELT. wcslib 8.10
# wcspih accepts them as CDi_j (WCSHDR_CD00i00j).
NOTE legacy_cd00i00j
GRID -100 612 5 -100 612 5
HEADER
NAXIS   = 2
NAXIS1  = 512
NAXIS2  = 512
CRVAL1  = 180.0
CRVAL2  = 30.0
CRPIX1  = 256.5
CRPIX2  = 256.5
CTYPE1  = 'RA---TAN'
CTYPE2  = 'DEC--TAN'
CD001001= -0.0009
CD001002= 0.0004
CD002001= 0.0004
CD002002= 0.0009
