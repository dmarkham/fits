# A SIP coefficient with a string value, A_0_2 = 'abc' (synthetic, from the
# round-3 verifier probe p35_coef_string). wcslib 8.10 accepts the header
# and computes without that term (the card's value does not parse as a
# number). A coefficient that is present but unreadable would be silently
# dropped; we refuse it.
# AP/BP are given so hdr2sky injects nothing.
# EXPECT-GO-ERROR: A_0_2 has a non-numeric value
NOTE stricter: sip_coef_string
GRID 1 1024 9 1 1024 9
HEADER
NAXIS   = 2
NAXIS1  = 1024
NAXIS2  = 1024
CRVAL1  = 150.0
CRVAL2  = 2.0
CRPIX1  = 512.5
CRPIX2  = 512.5
CTYPE1  = 'RA---TAN'
CTYPE2  = 'DEC--TAN'
CD1_1   = -0.0002777
CD1_2   = 0.0
CD2_1   = 0.0
CD2_2   = 0.0002777
A_ORDER = 2
B_ORDER = 2
A_2_0   = 2e-5
A_1_1   = 1e-5
B_0_2   = 2e-5
B_1_1   = -1e-5
A_0_2   = 'abc'
AP_ORDER= 1
AP_0_0  = 0.0
BP_ORDER= 1
BP_0_0  = 0.0
