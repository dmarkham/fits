# PLTDECSN = '-' written without a blank before the closing quote
# (synthetic). wcslib 8.10 reads the sign with sscanf("= '%s"), which takes
# "-'" and compares it with "-": it puts the plate centre at +22 deg instead
# of -22 deg. The FITS string value is '-', so we refuse the header rather
# than disagree with wcslib by 44 deg.
# EXPECT-GO-ERROR: PLTDECSN = '-' without a trailing blank
NOTE stricter: dss_pltdecsn_unpadded
GRID 1 400 3 1 300 3
HEADER
NAXIS   = 2
NAXIS1  = 400
NAXIS2  = 300
CNPIX1  = 9120
CNPIX2  = 4410
XPIXELSZ= 25.28445
YPIXELSZ= 25.28445
PPO3    = 177500.0
PPO6    = 177500.0
PLTRAH  = 5
PLTRAM  = 34
PLTRAS  = 31.94
PLTDECSN= '-'
PLTDECD = 22
PLTDECM = 0
PLTDECS = 52.2
AMDX1   = 6.7165566279E+01
AMDX2   = 1.8513587312E-02
AMDX3   = -4.3815032712E+01
AMDX4   = -1.2310232101E-05
AMDX5   = 1.5281391001E-05
AMDX6   = -2.2214129003E-05
